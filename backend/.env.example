DATABASE_URL=postgresql://postgres:your-password@localhost:54322/postgres?sslmode=prefer
SUPABASE_URL=https://your-project.supabase.co
ENVIRONMENT=development

# Clerk Backend Configuration
# Obtain CLERK_SECRET_KEY from Clerk Dashboard -> API Keys
CLERK_SECRET_KEY=sk_test_...
# Optional: Static Public JWT key from Clerk Dashboard -> JWT Templates / API Keys (PEM format)
CLERK_JWT_KEY=
# Optional: Custom Clerk Issuer URL (e.g. https://clerk.your-domain.com or https://verb-noun-00.clerk.accounts.dev)
CLERK_ISSUER=